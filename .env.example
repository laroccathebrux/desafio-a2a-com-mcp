# Segredo de integridade do requestState (HMAC). Minimo 32 bytes de aleatoriedade.
# Gere o seu com:  python3 -c "import secrets; print(secrets.token_hex(32))"
# NUNCA versione o valor real: este arquivo e so um exemplo.
REQUEST_STATE_SECRET=troque-por-um-valor-gerado-com-secrets-token_hex-32

# Opcionais (os defaults ja sao os que o validador espera):
# MCP_PORT=7301
# MCP_PATH=/mcp
# A2A_PORT=7300
# A2A_PATH=/a2a
# MCP_URL=http://localhost:7301/mcp
